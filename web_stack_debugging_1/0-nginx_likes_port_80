#!/usr/bin/env bash
# Fix Nginx to listen on port 80 on all active IPv4 IPs

# Step 1: Install nginx if not installed
apt-get update -y
apt-get install -y nginx

# Step 2: Fix port in nginx config if not set to 80
sed -i 's/listen [0-9]* default_server/listen 80 default_server/' /etc/nginx/sites-available/default
sed -i 's/listen \[::\]:[0-9]* default_server/listen [::]:80 default_server/' /etc/nginx/sites-available/default

# Step 3: Ensure sites-enabled is linked to sites-available
ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default

# Step 4: Test nginx config for syntax errors
nginx -t

# Step 5: Start or restart nginx
service nginx restart
