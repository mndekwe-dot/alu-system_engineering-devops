#!/usr/bin/env bash
# This script creates an RSA key pair with 4096 bits protected by the passphrase betty
ssh-keygen -t rsa -b 4096 -N betty -f school

# Verify the school file is an RSA private key
file school | grep -i "rsa private key"

# Verify the RSA key has a passphrase (key requires decryption)
grep -q "ENCRYPTED" school

# Verify the RSA key is 4096 bits
ssh-keygen -l -f school | grep -i "4096"

# Verify the school file exists after script execution
test -f school && echo "school file exists"
