#!/usr/bin/env bash
# Script to install and configure Nginx web server to display "Holberton School"

# Update package list and install Nginx with -y flag to auto-confirm
apt-get update
apt-get install -y nginx

# Create the custom HTML page with the required content
echo "Holberton School" > /var/www/html/index.html

# Start Nginx service
service nginx start
